# Clerk — RETIRED, migrating to Supabase Auth (see src/components/auth-provider.jsx,
# src/middleware.js, src/app/sign-in, src/app/sign-up). Leave unset on this branch;
# these are only still read by files the sweep task hasn't converted yet. Safe to
# delete entirely once that sweep (and @clerk/nextjs's removal from package.json) lands.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (Project Settings -> API). NEXT_PUBLIC_* vars are also the ones the new
# Supabase Auth client (src/lib/supabase-clients.js) and middleware.js use for
# sign-in/sign-up/session-refresh — no separate auth-specific vars needed.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role key, same page, "service_role" secret. Server-only: never expose to the client.
# Needed for the Plaid routes (src/lib/plaid-server.js) to read/write public.plaid_items.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth ("Continue with Google" on /sign-in, /sign-up): configured in the
# Supabase Dashboard -> Authentication -> Providers -> Google (client id/secret
# live there, not in this app's env) — nothing to add here, just enable the
# provider and set the redirect URL to https://YOUR-PROJECT.supabase.co/auth/v1/callback
# in Google Cloud Console.

# Plaid (Plaid Dashboard -> Team Settings -> Keys). Optional: leave unset and the
# "Connected banks" section in Settings shows a setup note instead of breaking.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
